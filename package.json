{
  "name": "the-crowded-table-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "npm test -w client",
    "dev": "npm run dev -w client",
    "dev:api": "npm run start:hosted-db -w server",
    "dev:local": "npm run dev:local -w client",
    "dev:api:local": "npm start -w server",
    "build": "npm run check -w server && npm run build -w client",
    "lint": "eslint .",
    "preview": "npm run preview -w client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "@supabase/supabase-js": "^2.117.2"
  }
}
