  "records": [
    {
      "signature": "app_private.active_tenant(uuid)",
      "definition": "CREATE OR REPLACE FUNCTION app_private.active_tenant(p_tenant uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists (select 1 from public.tenants where id = p_tenant and operational_status = 'active')\n$function$\n"
    },
    {
      "signature": "app_private.guard_community_sharing()",
      "definition": "CREATE OR REPLACE FUNCTION app_private.guard_community_sharing()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_table_name='community_account_preferences' then\n    perform 1 from public.community_accounts where tenant_id=new.tenant_id\n      and user_id=new.user_id and standing <> 'inactive' for update;\n    if not found then raise exception 'inactive_community_sharing' using errcode='23514'; end if;\n  elsif exists(select from public.community_accounts c\n    join public.community_account_preferences p using(tenant_id,user_id)\n    where c.tenant_id=new.tenant_id and c.user_id=new.user_id and c.standing='inactive' and p.show_global_profile) then\n    raise exception 'inactive_community_sharing' using errcode='23514';\n  end if;\n  return new;\nend $function$\n"
    },
    {
      "signature": "app_private.is_approved_owner(uuid)",
      "definition": "CREATE OR REPLACE FUNCTION app_private.is_approved_owner(p_tenant uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists (\n    select 1 from public.tenant_staff_assignments s\n    join public.community_accounts c using (tenant_id, user_id)\n    where s.tenant_id = p_tenant and s.user_id = app_private.verified_user()\n      and s.role = 'owner' and s.status = 'active' and c.standing = 'approved'\n  )\n$function$\n"
    },
    {
      "signature": "app_private.my_community_relationships()",
      "definition": "CREATE OR REPLACE FUNCTION app_private.my_community_relationships()\n RETURNS TABLE(tenant_id uuid, is_owned boolean, is_managed boolean, is_member boolean)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select c.tenant_id,\n    coalesce(s.status='active' and s.role='owner' and c.standing='approved',false),\n    coalesce(s.status='active' and c.standing='approved',false),\n    c.standing in ('pending','approved','suspended')\n  from public.community_accounts c left join public.tenant_staff_assignments s using(tenant_id,user_id)\n  where c.user_id=app_private.verified_user() and c.standing in ('pending','approved','suspended')\n$function$\n"
    }
  ],
