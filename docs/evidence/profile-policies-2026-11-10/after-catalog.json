  "profile_constraints": [
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_bio_check",
      "definition": "CHECK ((char_length(bio) <= 2000))"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_created_by_fkey",
      "definition": "FOREIGN KEY (created_by) REFERENCES user_accounts(user_id) ON DELETE RESTRICT"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_display_name_check",
      "definition": "CHECK (((display_name = btrim(display_name)) AND ((char_length(display_name) >= 1) AND (char_length(display_name) <= 80))))"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_pkey",
      "definition": "PRIMARY KEY (tenant_id, user_id)"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_tenant_id_user_id_fkey",
      "definition": "FOREIGN KEY (tenant_id, user_id) REFERENCES community_accounts(tenant_id, user_id) ON DELETE RESTRICT"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_account_profiles_updated_by_fkey",
      "definition": "FOREIGN KEY (updated_by) REFERENCES user_accounts(user_id) ON DELETE RESTRICT"
    },
    {
      "relation": "community_account_profiles",
      "conname": "community_profile_canonical_bio",
      "definition": "CHECK (((bio IS NULL) OR ((bio = btrim(bio)) AND (bio <> ''::text)))) NOT VALID"
    },
    {
      "relation": "user_account_profiles",
      "conname": "global_profile_canonical_bio",
      "definition": "CHECK (((bio IS NULL) OR ((bio = btrim(bio)) AND (bio <> ''::text)))) NOT VALID"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_bio_check",
      "definition": "CHECK ((char_length(bio) <= 2000))"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_created_by_fkey",
      "definition": "FOREIGN KEY (created_by) REFERENCES user_accounts(user_id) ON DELETE RESTRICT"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_display_name_check",
      "definition": "CHECK (((display_name = btrim(display_name)) AND ((char_length(display_name) >= 1) AND (char_length(display_name) <= 80))))"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_pkey",
      "definition": "PRIMARY KEY (user_id)"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_updated_by_fkey",
      "definition": "FOREIGN KEY (updated_by) REFERENCES user_accounts(user_id) ON DELETE RESTRICT"
    },
    {
      "relation": "user_account_profiles",
      "conname": "user_account_profiles_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES user_accounts(user_id) ON DELETE RESTRICT"
    }
