  "functions": [
    {
      "signature": "app_private.guard_community_sharing()",
      "definition": "CREATE OR REPLACE FUNCTION app_private.guard_community_sharing()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_table_name='community_accounts' then\n    update public.community_account_preferences set show_global_profile=false\n      where tenant_id=new.tenant_id and user_id=new.user_id and show_global_profile;\n  else\n    perform 1 from public.community_accounts where tenant_id=new.tenant_id\n      and user_id=new.user_id and standing <> 'inactive' for update;\n    if not found then raise exception 'inactive_community_sharing' using errcode='23514'; end if;\n  end if;\n  return new;\nend $function$\n"
    },
    {
      "signature": "app_private.is_staff_candidate(uuid,uuid,boolean)",
      "definition": "CREATE OR REPLACE FUNCTION app_private.is_staff_candidate(p_tenant uuid, p_target uuid, p_lock boolean)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if p_tenant is distinct from app_private.command_scope() or not exists (\n    select from public.tenant_staff_assignments actor join public.tenants t on t.id=actor.tenant_id\n    join public.community_accounts target on target.tenant_id=t.id and target.user_id=p_target\n    where actor.tenant_id=p_tenant and actor.user_id=app_private.verified_user() and actor.status='active'\n      and actor.can_grant_staff and t.operational_status='active' and target.standing='approved'\n  ) then return false; end if;\n  if p_lock then perform id from auth.users where id=p_target for share; end if;\n  return exists(select from auth.users where id=p_target and email is not null and email_confirmed_at is not null\n    and not coalesce(is_anonymous,false) and (banned_until is null or banned_until<=now()));\nend $function$\n"
    },
    {
      "signature": "app_private.protect_invariants()",
      "definition": "CREATE OR REPLACE FUNCTION app_private.protect_invariants()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_table_name = 'tenants' and tg_op <> 'DELETE' then\n    if tg_op = 'UPDATE' and (new.id <> old.id or new.slug <> old.slug) then\n      raise exception 'tenant_identity_immutable' using errcode = '23514';\n    end if;\n    if not exists (select 1 from pg_catalog.pg_timezone_names where name = new.timezone) then\n      raise exception 'invalid_timezone' using errcode = '23514';\n    end if;\n  elsif tg_table_name = 'tenant_staff_assignments' then\n    if tg_op = 'INSERT' and new.role = 'owner' then\n      new.can_approve_users := true;\n      new.can_create_admin := true;\n      new.can_modify_content := true;\n    elsif tg_op <> 'INSERT' then\n      if old.role = 'owner' and (tg_op = 'DELETE' or new is distinct from old) then\n        raise exception 'owner_assignment_immutable' using errcode = '23514';\n      end if;\n      if tg_op = 'UPDATE' and (new.tenant_id <> old.tenant_id or new.user_id <> old.user_id or new.role <> old.role) then\n        raise exception 'staff_identity_immutable' using errcode = '23514';\n      end if;\n    end if;\n  elsif tg_op = 'UPDATE' then\n    if to_jsonb(new)->'tenant_id' is distinct from to_jsonb(old)->'tenant_id'\n       or to_jsonb(new)->'user_id' is distinct from to_jsonb(old)->'user_id'\n       or (tg_table_name = 'tenant_website_content_overrides'\n         and to_jsonb(new)->'content_key' is distinct from to_jsonb(old)->'content_key') then\n      raise exception 'account_identity_immutable' using errcode = '23514';\n    end if;\n  end if;\n  if tg_op = 'DELETE' then return old; end if;\n  return new;\nend $function$\n"
    }
  ],
